+def _glorot_uniform_vector(units):
+    # Keras VarianceScaling (glorot_uniform) treats a 1D shape as fan_in == fan_out == units.
+    limit = math.sqrt(6.0 / (units + units))
+    return nn.Parameter(torch.empty(units).uniform_(-limit, limit))
+
+
+class PeepholeLSTMCell(nn.Module):
+    """Equivalent to tfa.rnn.PeepholeLSTMCell (Sak et al., 2014 peephole LSTM)."""
+
+    def __init__(self, input_size, units):
+        super().__init__()
+        self.units = units
+        self.kernel = nn.Parameter(torch.empty(input_size, units * 4))
+        self.recurrent_kernel = nn.Parameter(torch.empty(units, units * 4))
+        self.bias = nn.Parameter(torch.zeros(units * 4))
+        self.input_gate_peephole_weights = _glorot_uniform_vector(units)
+        self.forget_gate_peephole_weights = _glorot_uniform_vector(units)
+        self.output_gate_peephole_weights = _glorot_uniform_vector(units)
+        self.reset_parameters()
+
+    def reset_parameters(self):
+        nn.init.xavier_uniform_(self.kernel)
+        nn.init.orthogonal_(self.recurrent_kernel)
+        with torch.no_grad():
+            self.bias.zero_()
+            self.bias[self.units:self.units * 2].fill_(1.0)  # unit_forget_bias
+
+    def forward(self, x, h_prev, c_prev):
+        z = x @ self.kernel + h_prev @ self.recurrent_kernel + self.bias
+        z_i, z_f, z_c, z_o = z.split(self.units, dim=-1)
+        i = torch.sigmoid(z_i + self.input_gate_peephole_weights * c_prev)
+        f = torch.sigmoid(z_f + self.forget_gate_peephole_weights * c_prev)
+        c = f * c_prev + i * torch.tanh(z_c)
+        o = torch.sigmoid(z_o + self.output_gate_peephole_weights * c)
+        h = o * torch.tanh(c)
+        return h, c
+
+
+class BidirectionalPeepholeLSTM(nn.Module):
+    """Equivalent to Bidirectional(RNN(PeepholeLSTMCell(units)), merge_mode='sum')."""
+
+    def __init__(self, input_size, units):
+        super().__init__()
+        self.units = units
+        self.forward_cell = PeepholeLSTMCell(input_size, units)
+        self.backward_cell = PeepholeLSTMCell(input_size, units)
+
+    def forward(self, x):  # x: [B, T, input_size]
+        batch_size, seq_len, _ = x.shape
+        h_f = x.new_zeros(batch_size, self.units)
+        c_f = x.new_zeros(batch_size, self.units)
+        for t in range(seq_len):
+            h_f, c_f = self.forward_cell(x[:, t], h_f, c_f)
+        h_b = x.new_zeros(batch_size, self.units)
+        c_b = x.new_zeros(batch_size, self.units)
+        for t in reversed(range(seq_len)):
+            h_b, c_b = self.backward_cell(x[:, t], h_b, c_b)
+        return h_f + h_b
+
+
+def _make_cnn_backbone(mri_channels):
